# ==============================================================================
# LLM Provider Configuration (Google Gemini / Groq / OpenAI)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_MODEL=gemini-2.5-flash

# ==============================================================================
# Observability & Tracing (Langfuse Cloud or Self-Hosted)
# ==============================================================================
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ==============================================================================
# Storage & 3-Tier Memory Engine (SQLite + Qdrant)
# ==============================================================================
SQLITE_DB_PATH=./data/cognitive_memory.db
QDRANT_LOCAL_PATH=./data/qdrant_storage
QDRANT_URL=
QDRANT_API_KEY=

# ==============================================================================
# Agent Harness & Context Budget Controller Parameters
# ==============================================================================
TOKEN_BUDGET_LIMIT=32000
COMPACTION_THRESHOLD=0.70
GROUNDING_CONFIDENCE_THRESHOLD=0.80
MAX_RESEARCH_ITERATIONS=4
